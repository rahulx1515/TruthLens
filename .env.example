# ==========================================
# TRUTHLENS ENVIRONMENT CONFIGURATION
# ==========================================

# Application
PROJECT_NAME=TruthLens
PROJECT_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For local SQLite development (default zero-config):
DATABASE_URL=sqlite:///./truthlens.db
# For PostgreSQL (Docker / Render Production):
# DATABASE_URL=postgresql://truthlens_user:truthlens_password@localhost:5432/truthlens_db

# CORS Configuration (JSON array or comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ==========================================
# CLOUD LLM & GROQ / HUGGING FACE
# ==========================================
# LLM Provider selection: auto, groq, huggingface, ollama, none
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30

# Groq Cloud (Recommended for Render deployment: free, fast inference)
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Serverless Inference API (Optional alternative for generation & NLI)
# Get a user access token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# Alternative supported environment variable name for Hugging Face API key
HF_API_KEY=

# ==========================================
# LOCAL OLLAMA CONFIGURATION (Local Dev)
# ==========================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_THREADS=4

# ==========================================
# LIVE SEARCH SERVICES
# ==========================================
SEARXNG_URL=http://127.0.0.1:8080
GDELT_ENABLED=True
RSS_ENABLED=True

# ==========================================
# NLI VERIFICATION CONFIGURATION
# ==========================================
# Set False for lightweight cloud deployment (Render free/starter tiers) to save ~400 MB RAM.
# When False, verification uses Hugging Face API (if key set) or calibrated deterministic heuristic fallback.
# Set True only on machines with >= 2 GB available RAM for in-process PyTorch model loading.
ENABLE_LOCAL_NEURAL_NLI=False
NLI_MODEL_NAME=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
# Optional custom Hugging Face router / inference endpoint for NLI
HF_API_URL=
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.65
NLI_MAX_PASSAGES_PER_CLAIM=5

# ==========================================
# URL EXTRACTOR & SECURITY
# ==========================================
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_SIZE_BYTES=5242880
