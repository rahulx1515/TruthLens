# ==========================================
# TRUTHLENS 2.0 ENVIRONMENT CONFIGURATION
# ==========================================

# Application
PROJECT_NAME=TruthLens
PROJECT_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database configuration
# For local SQLite development (default zero-config):
DATABASE_URL=sqlite:///./truthlens.db
# For PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql://truthlens_user:truthlens_password@localhost:5432/truthlens_db

# CORS Configuration (JSON array or comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# TruthLens 2.0 - Local AI & Ollama Configuration
# Benchmarked optimal model: llama3.2:latest (3.2B parameters, ~1.15 GB RAM on CPU)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_THREADS=4

# TruthLens 2.0 - Live Search Services Configuration
# SearXNG local HTTP endpoint or external instance (optional fallback to GDELT & RSS)
SEARXNG_URL=http://127.0.0.1:8080
GDELT_ENABLED=True
RSS_ENABLED=True

# TruthLens 2.0 - NLI Natural Language Inference Engine
# Runs on CPU capped to 4 threads; falls back to deterministic lexical/semantic heuristic if offline
NLI_MODEL_NAME=MoritzLaurer/multilingual-MiniLMv2-L6-mnli-xnli
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.65
NLI_MAX_PASSAGES_PER_CLAIM=5

# Legacy 1.0 ML Model Configuration (Preserved for Stylistic Analysis)
ACTIVE_MODEL_PATH=app/ml/artifacts/fake_news_model.joblib
ACTIVE_VECTORIZER_PATH=app/ml/artifacts/tfidf_vectorizer.joblib
MODEL_METADATA_PATH=app/ml/artifacts/model_metadata.json

# URL Extractor Security Configuration (SSRF Protected)
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_SIZE_BYTES=5242880


